{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Bapu",
  "mainBinaryName": "Bapu",
  "version": "0.3.0",
  "identifier": "dev.bapu.desktop",
  "build": {
    "frontendDist": "../../web/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Bapu 扒谱",
        "url": "index.html",
        "width": 1360,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": [
          "bapu"
        ],
        "name": "Bapu 工程",
        "description": "Bapu 扒谱工程",
        "role": "Editor",
        "rank": "Owner",
        "exportedType": {
          "identifier": "dev.bapu.project",
          "conformsTo": [
            "public.json"
          ]
        }
      }
    ],
    "macOS": {
      "minimumSystemVersion": "14.0"
    }
  }
}
